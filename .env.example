# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/craftlove01?retryWrites=true&w=majority

# ── Authentication ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# JWT for admin sessions (required)
JWT_SECRET=your-jwt-secret-min-32-chars

# ── App URL ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Local File Uploads ─────────────────────────────────────────────────────────
# Base directory for publicly-served uploads (products, QR images).
# Relative to the project root. Defaults to public/uploads if not set.
UPLOAD_DIR=public/uploads

# Private directory for payment proofs (stored OUTSIDE public/ for security).
# Defaults to uploads/payment-proofs if not set.
PRIVATE_UPLOAD_DIR=uploads/payment-proofs

# Per-category size limits in megabytes
MAX_PRODUCT_IMAGE_SIZE_MB=5
MAX_QR_IMAGE_SIZE_MB=3
MAX_PAYMENT_PROOF_SIZE_MB=5

# ── Admin Seeding (used only by npm run seed:admin) ───────────────────────────
ADMIN_SEED_EMAIL=admin@craftlove01.com
ADMIN_SEED_PASSWORD=ChangeMe@2024!
ADMIN_SEED_NAME=Store Admin
